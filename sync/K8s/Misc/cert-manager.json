          {
            "datasource": {
              "type": "prometheus",
              "uid": "${DS_PROMETHEUS}"
            },
            "editorMode": "code",
            "expr": "certmanager_certificate_renewal_timestamp_seconds{exported_namespace=~\"$namespace\", issuer_name=~\"$issuer\"} - time()",
            "format": "table",
            "instant": true,
            "refId": "B"
          }
        ],
        "title": "Certificates",
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "__name__": true,
                "cluster": true,
                "container": true,
                "endpoint": true,
                "environment": true,
                "instance": true,
                "issuer_group": true,
                "job": true,
                "namespace": true,
                "pod": true,
                "prometheus": true,
                "service": true
              },
              "indexByName": {},
              "renameByName": {
                "Value #A": "Expires in",
                "Value #B": "Renews in",
                "exported_namespace": "Namespace",
                "issuer_kind": "Issuer kind",
                "issuer_name": "Issuer",
                "name": "Certificate"
              }
            }
          }
        ],
        "type": "table"
