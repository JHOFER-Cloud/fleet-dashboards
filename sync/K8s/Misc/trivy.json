            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count(count by (image_registry, image_repository, image_tag) (trivy_image_vulnerabilities{namespace=~\"$namespace\", severity=\"Critical\"} > 0)) or vector(0)",
