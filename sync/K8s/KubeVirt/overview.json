        "definition": "label_values(kubevirt_vm_info, namespace)",
        "query": {
          "qryType": 1,
          "query": "label_values(kubevirt_vm_info, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "regex": "",
        "options": []
      },
      {
        "name": "vm",
        "label": "VM",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kubevirt_vm_info{namespace=~\"$namespace\"}, name)",
        "query": {
          "qryType": 1,
          "query": "label_values(kubevirt_vm_info{namespace=~\"$namespace\"}, name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "regex": "",
        "options": []
