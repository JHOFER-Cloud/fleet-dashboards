          "expr": "sum by (namespace, name) (kubevirt_vmi_memory_available_bytes{namespace=~\"$namespace\",name=~\"$vm\"} - kubevirt_vmi_memory_usable_bytes{namespace=~\"$namespace\",name=~\"$vm\"})",
