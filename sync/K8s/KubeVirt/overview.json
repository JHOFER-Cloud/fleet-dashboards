    {
      "type": "bargauge",
      "title": "Memory requested",
      "description": "Share of allocatable memory reserved by pod requests on nodes that run VMs.",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (node) (kube_pod_container_resource_requests{resource=\"memory\"} * on (namespace, pod) group_left () (max by (namespace, pod) (kube_pod_status_phase{phase=~\"Pending|Running\"}) == 1) * on (node) group_left () kube_node_labels{label_kubevirt_io_schedulable=\"true\"}) / sum by (node) (kube_node_status_allocatable{resource=\"memory\"} * on (node) group_left () kube_node_labels{label_kubevirt_io_schedulable=\"true\"})",
          "legendFormat": "{{node}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Memory free for a VM",
      "description": "Unreserved memory per VM host: the largest VM (guest memory plus ~276Mi overhead) a start or migration target can still get there.",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
