        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(kubevirt_vm_info{status_group=\"running\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "id": 7
    },
    {
      "type": "bargauge",
      "title": "Web clients per host (15m)",
      "description": "Distinct client IPs with a successful (<400) request in Traefik's access log, excluding pod IPs, probes, uptime monitors and bots. Long-lived websockets (HASS app, SSH tunnel) only log when they close.",
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "displayName": "${__field.labels.RequestHost}",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "expr": "count by (RequestHost) (count by (RequestHost, ClientHost) (count_over_time({namespace=\"traefik\", container=\"traefik\"} |= \"RequestHost\" | json RequestHost, ClientHost, DownstreamStatus, ua=\"[\\\"request_User-Agent\\\"]\" | DownstreamStatus < 400 | ClientHost !~ \"10\\\\.244\\\\..*\" | ua !~ \"(?i).*(bot|spider|crawl|blackbox|kube-probe|prometheus|uptime|scanner|hookshot).*\" | RequestHost !~ \"$host_exclude\" [15m])))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "id": 8
    },
    {
      "type": "table",
      "title": "Jellyfin sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "jellyfin_user_active",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "username": true,
              "client": true,
              "device": true
            },
            "renameByName": {
              "username": "User",
              "client": "Client",
              "device": "Device"
            }
          }
        }
      ],
      "id": 9
    },
    {
      "type": "table",
      "title": "VM activity (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "CPU"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Network"
              },
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "CPU",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_cpu_usage_seconds_total[5m]))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, name) (rate(kubevirt_vmi_network_receive_bytes_total[5m]) + rate(kubevirt_vmi_network_transmit_bytes_total[5m]))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "id": 10
    },
