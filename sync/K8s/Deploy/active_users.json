{
  "uid": "active-users",
  "title": "Active users",
  "description": "Who is using the cluster's apps right now, to pick a quiet window for maintenance.",
  "tags": [
    "traefik",
    "jellyfin",
    "nextcloud",
    "kubevirt"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "k8_live_hla1",
          "value": "eef9f89usay9sb"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "loki_datasource",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "loki_k8_live_hla1",
          "value": "eegmz7m03591ce"
        },
        "hide": 2,
        "refresh": 1,
        "regex": ".*${datasource:text}",
        "options": []
      },
      {
        "name": "host_exclude",
        "label": "Hide hosts",
        "type": "textbox",
        "query": ".*\\.lan",
        "current": {
          "text": ".*\\.lan",
          "value": ".*\\.lan"
        },
        "hide": 0,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Web clients (15m)",
      "description": "Distinct client IPs with a successful (<400) request in Traefik's access log, excluding pod IPs, probes, uptime monitors and bots. Long-lived websockets (HASS app, SSH tunnel) only log when they close.",
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "expr": "count(count by (ClientHost) (count_over_time({namespace=\"traefik\", container=\"traefik\"} |= \"RequestHost\" | json RequestHost, ClientHost, DownstreamStatus, ua=\"[\\\"request_User-Agent\\\"]\" | DownstreamStatus < 400 | ClientHost !~ \"10\\\\.244\\\\..*\" | ua !~ \"(?i).*(bot|spider|crawl|blackbox|kube-probe|prometheus|uptime|scanner|hookshot).*\" | RequestHost !~ \"$host_exclude\" [15m]))) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Jellyfin sessions",
      "description": "Jellyfin sessions active in the last 60s, idle signed-in clients included.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(jellyfin_user_active) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Jellyfin playing",
      "description": "Streams currently playing (not paused), direct play and transcodes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(jellyfin_now_playing_state == 1) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "Nextcloud users (5m)",
      "description": "Nextcloud users active in the last five minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(nextcloud_active_users_total) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "id": 5
    },
    {
      "type": "stat",
      "title": "Busy VMs",
      "description": "KubeVirt VMs using more than 0.1 CPU cores. VMs have no login metric, CPU and network are the proxy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(sum by (namespace, name) (rate(kubevirt_vmi_cpu_usage_seconds_total[5m])) > 0.1) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "id": 6
    },
    {
      "type": "stat",
      "title": "Running VMs",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
